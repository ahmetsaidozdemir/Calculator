# Copy to .env to override the defaults built into docker-compose.yml.
# Every variable is optional.

# Host port for the web UI (container port 80).
FRONTEND_PORT=8080

# Host port for direct access to the Go API (container port 8080).
BACKEND_PORT=8081

# Where nginx finds the backend inside the Compose network.
BACKEND_INTERNAL_URI=http://backend:8080


# Only for a separately hosted API, e.g. http://localhost:8081.
# Leave empty to use same-origin /api through nginx.
VITE_BACKEND_EXTERNAL_URI=
